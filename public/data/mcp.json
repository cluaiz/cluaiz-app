{
  "group": "Model Context Protocol (MCP)",
  "endpoints": [
    {
      "method": "GET",
      "path": "/v1/mcp/list",
      "desc": "Returns all active Model Context Protocol (MCP) server bridges.",
      "docs_url": "/docs/reference/api.md",
      "params": [],
      "response": "{\n  \"status\": \"success\",\n  \"mcp_servers\": [\n    {\n      \"id\": \"sqlite_mcp\",\n      \"name\": \"sqlite_mcp\",\n      \"category\": \"mcp\",\n      \"status\": \"active\"\n    }\n  ]\n}",
      "examples": [
        {
          "language": "curl",
          "title": "cURL",
          "code": "curl -X GET http://localhost:8000/v1/mcp/list"
        },
        {
          "language": "python",
          "title": "Python",
          "code": "import requests\n\nres = requests.get('http://localhost:8000/v1/mcp/list')\nprint(res.json())"
        },
        {
          "language": "javascript",
          "title": "Node.js",
          "code": "const response = await fetch('http://localhost:8000/v1/mcp/list');\nconst data = await response.json();\nconsole.log(data);"
        },
        {
          "language": "rust",
          "title": "Rust",
          "code": "let res = reqwest::get(\"http://localhost:8000/v1/mcp/list\").await?;\nprintln!(\"{:#?}\", res.json::<serde_json::Value>().await?);"
        }
      ]
    },
    {
      "method": "POST",
      "path": "/v1/mcp/install",
      "desc": "Registers and queues an MCP server installation natively.",
      "docs_url": "/docs/reference/api.md",
      "params": [
        {
          "name": "mcp_name",
          "type": "string",
          "req": true,
          "desc": "Name or identifier of the MCP server.",
          "default": "sqlite_mcp"
        }
      ],
      "request_payload": "{\n  \"mcp_name\": \"sqlite_mcp\"\n}",
      "response": "{\n  \"status\": \"success\",\n  \"message\": \"MCP server 'sqlite_mcp' installation queued.\"\n}",
      "examples": [
        {
          "language": "curl",
          "title": "cURL",
          "code": "curl -X POST http://localhost:8000/v1/mcp/install \\\n  -H 'Content-Type: application/json' \\\n  -d '{\"mcp_name\": \"sqlite_mcp\"}'"
        },
        {
          "language": "python",
          "title": "Python",
          "code": "import requests\n\nres = requests.post('http://localhost:8000/v1/mcp/install', json={\"mcp_name\": \"sqlite_mcp\"})\nprint(res.json())"
        },
        {
          "language": "javascript",
          "title": "Node.js",
          "code": "const response = await fetch('http://localhost:8000/v1/mcp/install', {\n  method: 'POST',\n  headers: { 'Content-Type': 'application/json' },\n  body: JSON.stringify({ mcp_name: 'sqlite_mcp' })\n});\nconst data = await response.json();\nconsole.log(data);"
        },
        {
          "language": "rust",
          "title": "Rust",
          "code": "let client = reqwest::Client::new();\nlet res = client.post(\"http://localhost:8000/v1/mcp/install\")\n    .json(&serde_json::json!({ \"mcp_name\": \"sqlite_mcp\" }))\n    .send()\n    .await?;\nprintln!(\"{:#?}\", res.json::<serde_json::Value>().await?);"
        }
      ]
    },
    {
      "method": "DELETE",
      "path": "/v1/mcp/remove",
      "desc": "Removes an MCP server bridge natively.",
      "docs_url": "/docs/reference/api.md",
      "params": [
        {
          "name": "mcp_name",
          "type": "string",
          "req": true,
          "desc": "Name of the MCP server to remove.",
          "default": "sqlite_mcp"
        }
      ],
      "request_payload": "{\n  \"mcp_name\": \"sqlite_mcp\"\n}",
      "response": "{\n  \"status\": \"success\",\n  \"message\": \"MCP server 'sqlite_mcp' removed natively.\"\n}",
      "examples": [
        {
          "language": "curl",
          "title": "cURL",
          "code": "curl -X DELETE http://localhost:8000/v1/mcp/remove \\\n  -H 'Content-Type: application/json' \\\n  -d '{\"mcp_name\": \"sqlite_mcp\"}'"
        },
        {
          "language": "python",
          "title": "Python",
          "code": "import requests\n\nres = requests.delete('http://localhost:8000/v1/mcp/remove', json={\"mcp_name\": \"sqlite_mcp\"})\nprint(res.json())"
        },
        {
          "language": "javascript",
          "title": "Node.js",
          "code": "const response = await fetch('http://localhost:8000/v1/mcp/remove', {\n  method: 'DELETE',\n  headers: { 'Content-Type': 'application/json' },\n  body: JSON.stringify({ mcp_name: 'sqlite_mcp' })\n});\nconst data = await response.json();\nconsole.log(data);"
        },
        {
          "language": "rust",
          "title": "Rust",
          "code": "let client = reqwest::Client::new();\nlet res = client.delete(\"http://localhost:8000/v1/mcp/remove\")\n    .send()\n    .await?;\nprintln!(\"{:#?}\", res.json::<serde_json::Value>().await?);"
        }
      ]
    },
    {
      "method": "GET",
      "path": "/v1/mcp/cache",
      "desc": "Lists the active caches for MCP servers.",
      "docs_url": "/docs/reference/api.md",
      "params": [],
      "response": "{\n  \"status\": \"success\",\n  \"message\": \"MCP cache report: 0 items.\"\n}",
      "examples": [
        {
          "language": "curl",
          "title": "cURL",
          "code": "curl -X GET http://localhost:8000/v1/mcp/cache"
        }
      ]
    },
    {
      "method": "DELETE",
      "path": "/v1/mcp/cache",
      "desc": "Clears MCP server caches.",
      "docs_url": "/docs/reference/api.md",
      "params": [
        {
          "name": "mcp_name",
          "type": "string",
          "req": false,
          "desc": "Target specific MCP server or 'all'.",
          "default": "all"
        }
      ],
      "request_payload": "{\n  \"mcp_name\": \"all\"\n}",
      "response": "{\n  \"status\": \"success\",\n  \"message\": \"Successfully wiped MCP caches.\"\n}",
      "examples": [
        {
          "language": "curl",
          "title": "cURL",
          "code": "curl -X DELETE http://localhost:8000/v1/mcp/cache \\\n  -H 'Content-Type: application/json' \\\n  -d '{\"mcp_name\": \"all\"}'"
        }
      ]
    }
  ]
}
