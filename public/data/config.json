{
  "group": "Component Configuration",
  "endpoints": [
    {
      "method": "GET",
      "path": "/api/components/list",
      "desc": "Discovers all installed components (plugins, skills, and MCP servers) with their active security modes and token costs.",
      "docs_url": "/docs/reference/api.md",
      "params": [],
      "response": "{\n  \"plugin\": [\"web-scraper\"],\n  \"skill\": [\"code-review\"],\n  \"mcp\": [\"sqlite_mcp\"],\n  \"rich\": {}\n}",
      "examples": [
        {
          "language": "curl",
          "title": "cURL",
          "code": "curl -X GET http://localhost:8000/api/components/list"
        }
      ]
    },
    {
      "method": "GET",
      "path": "/api/components/settings",
      "desc": "Reads configuration settings for a component directly from ToolsRegistry.",
      "docs_url": "/docs/reference/api.md",
      "params": [
        {
          "name": "component_type",
          "type": "string",
          "req": true,
          "desc": "Component category ('plugin', 'skill', 'mcp').",
          "default": "plugin"
        },
        {
          "name": "component_id",
          "type": "string",
          "req": true,
          "desc": "Unique component identifier.",
          "default": "web-scraper"
        }
      ],
      "response": "{\n  \"status\": \"success\",\n  \"schema\": {},\n  \"values\": {\n    \"enabled\": true,\n    \"security_mode\": \"sandboxed\",\n    \"execution_mode\": \"auto\"\n  }\n}",
      "examples": [
        {
          "language": "curl",
          "title": "cURL",
          "code": "curl -X GET 'http://localhost:8000/api/components/settings?component_type=plugin&component_id=web-scraper'"
        }
      ]
    },
    {
      "method": "POST",
      "path": "/api/components/settings",
      "desc": "Updates configuration settings (enabled status, security mode) for a component in ToolsRegistry.",
      "docs_url": "/docs/reference/api.md",
      "params": [
        {
          "name": "component_id",
          "type": "string",
          "req": true,
          "desc": "The component identifier.",
          "default": "web-scraper"
        },
        {
          "name": "settings",
          "type": "object",
          "req": true,
          "desc": "Key-value map of settings to apply.",
          "default": {
            "enabled": true,
            "security_mode": "sandboxed"
          }
        }
      ],
      "request_payload": "{\n  \"component_id\": \"web-scraper\",\n  \"settings\": {\n    \"enabled\": true,\n    \"security_mode\": \"sandboxed\"\n  }\n}",
      "response": "{\n  \"status\": \"success\"\n}",
      "examples": [
        {
          "language": "curl",
          "title": "cURL",
          "code": "curl -X POST http://localhost:8000/api/components/settings \\\n  -H 'Content-Type: application/json' \\\n  -d '{\"component_id\": \"web-scraper\", \"settings\": {\"enabled\": true}}'"
        }
      ]
    }
  ]
}
