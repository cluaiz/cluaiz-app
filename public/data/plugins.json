{
  "group": "Native Plugins",
  "endpoints": [
    {
      "method": "GET",
      "path": "/v1/plugins/list",
      "desc": "Returns a list of all active native plugins installed in the Engine.",
      "docs_url": "/docs/reference/api.md",
      "params": [],
      "response": "{\n  \"status\": \"success\",\n  \"plugins\": [\n    {\n      \"id\": \"web-scraper\",\n      \"name\": \"web-scraper\",\n      \"version\": \"1.0.0\",\n      \"category\": \"plugin\"\n    }\n  ]\n}",
      "examples": [
        {
          "language": "curl",
          "title": "cURL",
          "code": "curl -X GET http://localhost:8000/v1/plugins/list"
        },
        {
          "language": "python",
          "title": "Python",
          "code": "import requests\n\nres = requests.get('http://localhost:8000/v1/plugins/list')\nprint(res.json())"
        },
        {
          "language": "javascript",
          "title": "Node.js",
          "code": "const response = await fetch('http://localhost:8000/v1/plugins/list');\nconst data = await response.json();\nconsole.log(data);"
        },
        {
          "language": "rust",
          "title": "Rust",
          "code": "let res = reqwest::get(\"http://localhost:8000/v1/plugins/list\").await?;\nprintln!(\"{:#?}\", res.json::<serde_json::Value>().await?);"
        }
      ]
    },
    {
      "method": "POST",
      "path": "/v1/plugins/install",
      "desc": "Installs a native plugin into the Engine.",
      "docs_url": "/docs/reference/api.md",
      "params": [
        {
          "name": "plugin_name",
          "type": "string",
          "req": true,
          "desc": "Name or identifier of the plugin.",
          "default": "web-scraper"
        }
      ],
      "request_payload": "{\n  \"plugin_name\": \"web-scraper\"\n}",
      "response": "{\n  \"status\": \"success\",\n  \"message\": \"Plugin 'web-scraper' installation queued natively in Engine.\"\n}",
      "examples": [
        {
          "language": "curl",
          "title": "cURL",
          "code": "curl -X POST http://localhost:8000/v1/plugins/install \\\n  -H 'Content-Type: application/json' \\\n  -d '{\"plugin_name\": \"web-scraper\"}'"
        },
        {
          "language": "python",
          "title": "Python",
          "code": "import requests\n\nres = requests.post('http://localhost:8000/v1/plugins/install', json={\"plugin_name\": \"web-scraper\"})\nprint(res.json())"
        },
        {
          "language": "javascript",
          "title": "Node.js",
          "code": "const response = await fetch('http://localhost:8000/v1/plugins/install', {\n  method: 'POST',\n  headers: { 'Content-Type': 'application/json' },\n  body: JSON.stringify({ plugin_name: 'web-scraper' })\n});\nconst data = await response.json();\nconsole.log(data);"
        },
        {
          "language": "rust",
          "title": "Rust",
          "code": "let client = reqwest::Client::new();\nlet res = client.post(\"http://localhost:8000/v1/plugins/install\")\n    .json(&serde_json::json!({ \"plugin_name\": \"web-scraper\" }))\n    .send()\n    .await?;\nprintln!(\"{:#?}\", res.json::<serde_json::Value>().await?);"
        }
      ]
    },
    {
      "method": "DELETE",
      "path": "/v1/plugins/remove",
      "desc": "Removes a native plugin from the Engine.",
      "docs_url": "/docs/reference/api.md",
      "params": [
        {
          "name": "plugin_name",
          "type": "string",
          "req": true,
          "desc": "Name of the plugin to remove.",
          "default": "web-scraper"
        }
      ],
      "request_payload": "{\n  \"plugin_name\": \"web-scraper\"\n}",
      "response": "{\n  \"status\": \"success\",\n  \"message\": \"Plugin 'web-scraper' removed natively.\"\n}",
      "examples": [
        {
          "language": "curl",
          "title": "cURL",
          "code": "curl -X DELETE http://localhost:8000/v1/plugins/remove \\\n  -H 'Content-Type: application/json' \\\n  -d '{\"plugin_name\": \"web-scraper\"}'"
        },
        {
          "language": "python",
          "title": "Python",
          "code": "import requests\n\nres = requests.delete('http://localhost:8000/v1/plugins/remove', json={\"plugin_name\": \"web-scraper\"})\nprint(res.json())"
        },
        {
          "language": "javascript",
          "title": "Node.js",
          "code": "const response = await fetch('http://localhost:8000/v1/plugins/remove', {\n  method: 'DELETE',\n  headers: { 'Content-Type': 'application/json' },\n  body: JSON.stringify({ plugin_name: 'web-scraper' })\n});\nconst data = await response.json();\nconsole.log(data);"
        },
        {
          "language": "rust",
          "title": "Rust",
          "code": "let client = reqwest::Client::new();\nlet res = client.delete(\"http://localhost:8000/v1/plugins/remove\")\n    .send()\n    .await?;\nprintln!(\"{:#?}\", res.json::<serde_json::Value>().await?);"
        }
      ]
    },
    {
      "method": "GET",
      "path": "/v1/plugins/cache",
      "desc": "Lists the active caches for plugins.",
      "docs_url": "/docs/reference/api.md",
      "params": [],
      "response": "{\n  \"status\": \"success\",\n  \"message\": \"Plugin cache report: 0 items.\"\n}",
      "examples": [
        {
          "language": "curl",
          "title": "cURL",
          "code": "curl -X GET http://localhost:8000/v1/plugins/cache"
        },
        {
          "language": "python",
          "title": "Python",
          "code": "import requests\n\nres = requests.get('http://localhost:8000/v1/plugins/cache')\nprint(res.json())"
        },
        {
          "language": "javascript",
          "title": "Node.js",
          "code": "const response = await fetch('http://localhost:8000/v1/plugins/cache');\nconst data = await response.json();\nconsole.log(data);"
        },
        {
          "language": "rust",
          "title": "Rust",
          "code": "let res = reqwest::get(\"http://localhost:8000/v1/plugins/cache\").await?;\nprintln!(\"{:#?}\", res.json::<serde_json::Value>().await?);"
        }
      ]
    },
    {
      "method": "DELETE",
      "path": "/v1/plugins/cache",
      "desc": "Clears plugin caches.",
      "docs_url": "/docs/reference/api.md",
      "params": [
        {
          "name": "plugin_name",
          "type": "string",
          "req": false,
          "desc": "Target specific plugin name or 'all'.",
          "default": "all"
        }
      ],
      "request_payload": "{\n  \"plugin_name\": \"all\"\n}",
      "response": "{\n  \"status\": \"success\",\n  \"message\": \"Successfully wiped caches.\"\n}",
      "examples": [
        {
          "language": "curl",
          "title": "cURL",
          "code": "curl -X DELETE http://localhost:8000/v1/plugins/cache \\\n  -H 'Content-Type: application/json' \\\n  -d '{\"plugin_name\": \"all\"}'"
        },
        {
          "language": "python",
          "title": "Python",
          "code": "import requests\n\nres = requests.delete('http://localhost:8000/v1/plugins/cache', json={\"plugin_name\": \"all\"})\nprint(res.json())"
        },
        {
          "language": "javascript",
          "title": "Node.js",
          "code": "const response = await fetch('http://localhost:8000/v1/plugins/cache', {\n  method: 'DELETE',\n  headers: { 'Content-Type': 'application/json' },\n  body: JSON.stringify({ plugin_name: 'all' })\n});\nconst data = await response.json();\nconsole.log(data);"
        },
        {
          "language": "rust",
          "title": "Rust",
          "code": "let client = reqwest::Client::new();\nlet res = client.delete(\"http://localhost:8000/v1/plugins/cache\")\n    .json(&serde_json::json!({ \"plugin_name\": \"all\" }))\n    .send()\n    .await?;\nprintln!(\"{:#?}\", res.json::<serde_json::Value>().await?);"
        }
      ]
    }
  ]
}
