{
  "group": "System & Control",
  "endpoints": [
    {
      "method": "GET",
      "path": "/health",
      "desc": "Checks the core engine health, memory status, and continuous uptime.",
      "docs_url": "/docs/api/system/health.md",
      "params": [],
      "response": "{\n  \"status\": \"healthy\",\n  \"uptime_ms\": 145020,\n  \"components\": {\n    \"db\": \"healthy\",\n    \"gpu\": \"healthy\"\n  }\n}",
      "examples": [
        {
          "language": "curl",
          "title": "cURL",
          "code": "curl -X GET http://localhost:8000/health"
        },
        {
          "language": "python",
          "title": "Python",
          "code": "import requests\n\nres = requests.get('http://localhost:8000/health')\nprint(res.json())"
        },
        {
          "language": "javascript",
          "title": "Node.js",
          "code": "const response = await fetch('http://localhost:8000/health');\nconst data = await response.json();\nconsole.log(data);"
        },
        {
          "language": "rust",
          "title": "Rust",
          "code": "let res = reqwest::get(\"http://localhost:8000/health\").await?;\nprintln!(\"{:#?}\", res.json::<serde_json::Value>().await?);"
        }
      ]
    },
