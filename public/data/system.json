    {
      "method": "POST",
      "path": "/v1/system/cmd",
      "desc": "Executes shell commands locally. STRICTLY bound to 127.0.0.1 (Localhost). Rejects any remote attempts to prevent RCE.",
      "docs_url": "/docs/api/system/cmd.md",
      "params": [
        {
          "name": "command",
          "type": "string",
          "req": true,
          "desc": "The raw shell command to execute.",
          "default": "echo Hello cluaiz"
        }
      ],
      "request_payload": "{\n  \"command\": \"echo Hello cluaiz\"\n}",
      "response": "{\n  \"status\": \"success\",\n  \"output\": \"Hello cluaiz\\n\",\n  \"exit_code\": 0\n}",
      "examples": [
        {
          "language": "curl",
          "title": "cURL",
          "code": "curl -X POST http://localhost:8000/v1/system/cmd \\\n  -H 'Content-Type: application/json' \\\n  -d '{\"command\": \"echo Hello cluaiz\"}'"
        },
        {
          "language": "python",
          "title": "Python",
          "code": "import requests\n\nres = requests.post('http://localhost:8000/v1/system/cmd', json={\"command\": \"echo Hello cluaiz\"})\nprint(res.json())"
        },
        {
          "language": "javascript",
          "title": "Node.js",
          "code": "const response = await fetch('http://localhost:8000/v1/system/cmd', {\n  method: 'POST',\n  headers: { 'Content-Type': 'application/json' },\n  body: JSON.stringify({ command: 'echo Hello cluaiz' })\n});\nconst data = await response.json();\nconsole.log(data);"
        },
        {
          "language": "rust",
          "title": "Rust",
          "code": "let client = reqwest::Client::new();\nlet res = client.post(\"http://localhost:8000/v1/system/cmd\")\n    .json(&serde_json::json!({\n        \"command\": \"echo Hello cluaiz\" }))\n    .send()\n    .await?;\nprintln!(\"{:#?}\", res.json::<serde_json::Value>().await?);"
        }
      ]
    }
