{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cluaiz Extension Surface Prototype",
  "version": "0.1.0",
  "identifier": "com.cluaiz.extension-surface-prototype",
  "build": { "frontendDist": "assets" },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost",
      "assetProtocol": { "enable": true, "scope": [] }
    }
  },
  "bundle": { "active": false, "icon": ["../../public/logo.ico"] }
}
